NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
ADMIN_EMAIL=admin@example.com
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_WEBHOOK_SECRET=replace-me
CLIENT_TELEGRAM_BOT_TOKEN=123456:replace-me-client
CLIENT_TELEGRAM_WEBHOOK_SECRET=replace-me-client
# Секрет для тика отложенных рассылок (pg_cron -> /api/cron/dispatch-broadcasts).
# То же значение прописать в миграции scheduled_broadcasts вместо <CRON_SECRET>.
CRON_SECRET=replace-me-cron
TMA_SUPER_ADMIN_ID=123456789
VERCEL_PROJECT_PRODUCTION_URL=your-domain.vercel.app
# Optional override for the client Telegram Mini App URL.
# Defaults to https://$VERCEL_PROJECT_PRODUCTION_URL/client
CLIENT_TMA_URL=
# Вход через Яндекс ID для веб-версии (игроки без телеграма).
# client_id и client_secret — из oauth.yandex.ru, приложение клуба.
YANDEX_CLIENT_ID=replace-me
YANDEX_CLIENT_SECRET=replace-me
# Подпись сессионной cookie веб-входа: openssl rand -base64 32
SESSION_SECRET=replace-me
# Необязательно: адрес возврата OAuth, если он не https://$VERCEL_PROJECT_PRODUCTION_URL/api/auth/yandex/callback
YANDEX_REDIRECT_URI=
GOOGLE_SHEET_ID=replace-me
# Отдельная таблица с финансами (лист на каждую игру). Сервис-аккаунт должен быть
# добавлен в неё как Редактор; без переменной финансовый лист просто не пишется.
GOOGLE_FINANCE_SHEET_ID=replace-me
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account"}
