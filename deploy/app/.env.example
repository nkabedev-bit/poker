# /opt/club/.env on the server — the app's settings. Copy, fill in, chmod 600.
# Never commit the filled-in file.

# Domains (also read by docker compose for Caddy)
APP_DOMAIN=pokerptz.ru
API_DOMAIN=api.pokerptz.ru

# Supabase (self-hosted, /opt/supabase/.env holds the keys)
NEXT_PUBLIC_SUPABASE_URL=https://api.pokerptz.ru
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=

# The site's own address, read where links back to the site are built
VERCEL_PROJECT_PRODUCTION_URL=pokerptz.ru
CLIENT_TMA_URL=https://pokerptz.ru/client
YANDEX_REDIRECT_URI=https://pokerptz.ru/api/auth/yandex/callback

# Telegram: bot calls go through the relay on Vercel (api.telegram.org is cut in Russia)
TELEGRAM_API_ROOT=https://poker-two-liart.vercel.app/api/tg-relay
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
CLIENT_TELEGRAM_BOT_TOKEN=
CLIENT_TELEGRAM_WEBHOOK_SECRET=
TMA_SUPER_ADMIN_ID=

# Google Sheets (service account JSON on one line)
GOOGLE_SHEET_ID=
GOOGLE_FINANCE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=

# Web sign-in with Yandex ID
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
SESSION_SECRET=

# Shared by pg_cron and /api/cron/*
CRON_SECRET=
